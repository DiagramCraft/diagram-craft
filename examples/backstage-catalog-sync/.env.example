# Arch Register Configuration (Required)
ARCH_REGISTER_URL=http://127.0.0.1:3000
ARCH_REGISTER_WORKSPACE=default
ARCH_REGISTER_TOKEN=ar_pat_...

# GitHub Configuration (Optional - for private repos or higher rate limits)
GITHUB_TOKEN=

# Schema Mapping (Optional - auto-discover by name if not provided)
# These are the UUIDs of the schemas in your Arch Register workspace
SCHEMA_DOMAIN=
SCHEMA_SYSTEM=
SCHEMA_COMPONENT=
SCHEMA_API=
SCHEMA_RESOURCE=

# Sync Configuration (Optional)
DRY_RUN=false
