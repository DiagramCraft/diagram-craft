{
  "info": {
    "title": "Diagram Craft Adapter API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "openapi": "3.1.1",
  "paths": {
    "/adapters/diagram-craft/{workspace}/schemas": {
      "get": {
        "operationId": "diagramCraft.getSchemas",
        "summary": "Get public schemas",
        "description": "Retrieves publicly accessible schema definitions for diagram collaboration. Used by Diagram Craft for entity integration.",
        "tags": [
          "Diagram Craft",
          "Diagram Craft"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "description": "Schema field identifier"
                            },
                            "name": {
                              "type": "string",
                              "description": "Schema field name"
                            },
                            "type": {
                              "type": "string",
                              "description": "Diagram Craft field type"
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "type"
                          ],
                          "additionalProperties": {}
                        }
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "fields"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/adapters/diagram-craft/{workspace}/data": {
      "get": {
        "operationId": "diagramCraft.getData",
        "summary": "Get public entity data",
        "description": "Retrieves publicly accessible entity data for diagram collaboration. Used by Diagram Craft for entity references.",
        "tags": [
          "Diagram Craft",
          "Diagram Craft"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/adapters/diagram-craft/{workspace}/ai/generate": {
      "post": {
        "operationId": "diagramCraft.generate",
        "summary": "Generate diagram with AI",
        "description": "Uses AI to generate diagram content based on provided messages. Supports streaming responses for real-time generation.",
        "tags": [
          "Diagram Craft",
          "Diagram Craft"
        ],
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "enum": [
                            "system",
                            "user",
                            "assistant"
                          ],
                          "type": "string",
                          "description": "Message role"
                        },
                        "content": {
                          "description": "Message content"
                        }
                      },
                      "required": [
                        "role"
                      ]
                    },
                    "description": "Conversation messages for AI generation"
                  },
                  "stream": {
                    "type": "boolean",
                    "description": "Whether to stream the response"
                  },
                  "temperature": {
                    "type": "number",
                    "description": "Temperature parameter for generation (0-2)"
                  },
                  "max_tokens": {
                    "type": "number",
                    "description": "Maximum tokens to generate"
                  }
                },
                "required": [
                  "messages"
                ],
                "additionalProperties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "event": {
                          "const": "message"
                        },
                        "data": {},
                        "id": {
                          "type": "string"
                        },
                        "retry": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "event"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "event": {
                          "const": "done"
                        },
                        "data": {},
                        "id": {
                          "type": "string"
                        },
                        "retry": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "event"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "event": {
                          "const": "error"
                        },
                        "data": {},
                        "id": {
                          "type": "string"
                        },
                        "retry": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "event"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
