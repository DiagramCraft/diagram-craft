// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@arch-register/server/*": ["../arch-register-packages/server/src/*"],
      "@arch-register/api-types/*": ["../arch-register-packages/api-types/src/*"],
      "@site/*": ["./*"]
    },
    "types": ["node"],
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
